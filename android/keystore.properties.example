# Параметры подписи релизной сборки. Схема файла — в git, сам
# android/keystore.properties — нет: утечка ключа означает потерю возможности
# обновлять приложение в сторе.
#
# Скопировать в android/keystore.properties и заполнить своими значениями.
# Без этого файла `gradlew assembleRelease` соберёт неподписанный APK
# (сборка не падает, но артефакт нельзя ни установить, ни опубликовать).
#
# Создать keystore:
#   keytool -genkeypair -v -keystore <путь>.keystore -alias recverter \
#           -keyalg RSA -keysize 4096 -validity 10950 -storetype PKCS12
#
# Пароли хранить в менеджере секретов, не в репозитории и не в истории команд.

# Путь к keystore. Относительный путь считается от папки android/
# (там же, где лежит этот файл), поэтому «../» — корень репозитория.
# Абсолютный путь тоже допустим.
storeFile=../.claude/tmp/recverter-release.keystore

# Пароль хранилища.
storePassword=

# Псевдоним ключа внутри хранилища (аргумент -alias при генерации).
keyAlias=recverter

# Пароль ключа. Для PKCS12 совпадает с паролем хранилища.
keyPassword=
