<resources>
  <!-- Фон окна до первого кадра React Native. Совпадает с `background` светлой
       палитры из src/ui/theme.ts: если разойдётся хоть на тон, холодный старт
       начнётся со вспышки чужого цвета. Тёмный вариант — values-night/colors.xml. -->
  <color name="splashscreen_background">#FFFFFF</color>
  <!-- Цвет «play» на splash-иконке. Он же `text` из палитры: белый треугольник
       брендовой иконки живёт на тёмной подложке лаунчера, а на splash подложки
       нет, и на белом фоне он бы исчез. Дуги остаются фирменными — #35C4F0
       различим на обоих фонах. -->
  <color name="splashscreen_glyph">#101114</color>
  <!-- Задний слой адаптивной иконки. Плоский цвет, а не картинка: под круглой,
